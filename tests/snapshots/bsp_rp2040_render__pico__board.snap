//! Board-level entry point for Raspberry Pi Pico.
//!
//! Generated by rlvgl-creator BSP generator.
//! Chip: RP2040 (2-core cortex-m0plus)
//! Flash: 2 MB

#![allow(unused)]

use super::{clocks, gpio, peripherals};

/// Board-level initialization.
///
/// Calls clock, GPIO, and peripheral init in the correct order.
pub unsafe fn init() {
    clocks::init_clocks();
    gpio::init_pins();
    peripherals::init_peripherals();
}

/// Console configuration.
pub const CONSOLE_PERIPHERAL: &str = "uart0";
pub const CONSOLE_BAUD: u32 = 115200;

/// Board feature: flash_type
pub const FEATURE_FLASH_TYPE: &str = "w25q16jv";

/// Board feature: has_usb
pub const FEATURE_HAS_USB: &str = "true";

/// Board feature: led_count
pub const FEATURE_LED_COUNT: &str = "1";
