---
source: tests/rp_ir_roundtrip.rs
expression: "&ir"
---
chip:
  name: RP2040
  arch: cortex-m0plus
  alt_arch: ~
  cores: 2
  max_freq_hz: 133000000
  package: QFN56
  pac_crate: rp2040_pac
  gpio_count: 30
  memory:
    - name: xip
      base: 268435456
      size: 16777216
      access: rx
    - name: sram0
      base: 536870912
      size: 65536
      access: rwx
    - name: sram1
      base: 536936448
      size: 65536
      access: rwx
    - name: sram2
      base: 537001984
      size: 65536
      access: rwx
    - name: sram3
      base: 537067520
      size: 65536
      access: rwx
    - name: sram4
      base: 537133056
      size: 4096
      access: rwx
    - name: sram5
      base: 537137152
      size: 4096
      access: rwx
  clock_tree:
    xosc_hz: 12000000
    rosc_hz: 6500000
    plls:
      - name: sys_pll
        ref_div: 1
        vco_freq_hz: 1596000000
        post_div1: 6
        post_div2: 2
      - name: usb_pll
        ref_div: 1
        vco_freq_hz: 1200000000
        post_div1: 5
        post_div2: 5
    clk_domains:
      - name: clk_sys
        default_hz: 133000000
      - name: clk_ref
        default_hz: 12000000
      - name: clk_peri
        default_hz: 133000000
      - name: clk_usb
        default_hz: 48000000
      - name: clk_adc
        default_hz: 48000000
      - name: clk_rtc
        default_hz: 46875
  resets:
    adc: 0
    busctrl: 1
    dma: 2
    i2c0: 3
    i2c1: 4
    io_bank0: 5
    io_qspi: 6
    jtag: 7
    pads_bank0: 8
    pads_qspi: 9
    pio0: 10
    pio1: 11
    pll_sys: 12
    pll_usb: 13
    pwm: 14
    rtc: 15
    spi0: 16
    spi1: 17
    syscfg: 18
    sysinfo: 19
    tbman: 20
    timer: 21
    uart0: 22
    uart1: 23
    usbctrl: 24
  peripherals:
    uart0:
      class: uart
      instance: uart0
      base: 1073954816
      irq: 20
      resets_bit: uart0
      state_machines: ~
      signals:
        - role: tx
          direction: out
        - role: rx
          direction: in
        - role: cts
          direction: in
        - role: rts
          direction: out
    uart1:
      class: uart
      instance: uart1
      base: 1073971200
      irq: 21
      resets_bit: uart1
      state_machines: ~
      signals:
        - role: tx
          direction: out
        - role: rx
          direction: in
    spi0:
      class: spi
      instance: spi0
      base: 1073987584
      irq: 18
      resets_bit: spi0
      state_machines: ~
      signals:
        - role: sck
          direction: out
        - role: mosi
          direction: out
        - role: miso
          direction: in
        - role: cs
          direction: out
    spi1:
      class: spi
