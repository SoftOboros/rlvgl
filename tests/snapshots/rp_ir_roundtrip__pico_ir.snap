board:
  name: Raspberry Pi Pico
  chip: RP2040
  arch_select: ~
  flash_mb: 2
  console:
    peripheral: uart0
    baud: 115200
  pins:
    - gpio: 0
      signal: UART0_TX
      peripheral: uart0
      role: tx
      direction: out
      label: u0_tx
      pull: ~
    - gpio: 1
      signal: UART0_RX
      peripheral: uart0
      role: rx
      direction: in
      label: u0_rx
      pull: ~
    - gpio: 25
      signal: LED
      peripheral: ~
      role: ~
      direction: out
      label: led
      pull: ~
  features:
    led_count: "1"
    has_usb: "true"
    flash_type: w25q16jv
  i2c_configs: {}
  spi_configs: {}
clocks:
  sys_hz: 133000000
  ref_hz: 12000000
  peri_hz: 133000000
  usb_hz: 48000000
  xosc_hz: 12000000
pins:
  - gpio: 0
    signal: UART0_TX
    peripheral: uart0
    role: tx
    direction: out
    label: u0_tx
    pull: ~
  - gpio: 1
    signal: UART0_RX
    peripheral: uart0
    role: rx
    direction: in
    label: u0_rx
    pull: ~
  - gpio: 25
    signal: LED
    peripheral: ~
    role: ~
    direction: out
    label: led
    pull: ~
