//! Per-peripheral initialization for ESP32-C3-DevKitM-1.
//!
//! Only the peripherals actually used by the board are referenced. v1 of the
//! generator emits real register writes for UART0 (when it is the console)
//! and leaves stubs for everything else with TODO markers pointing at the
//! relevant PAC register paths so a human can finish the init sequence.

use esp32c3 as pac;

use crate::board::APB_HZ;

/// Initialize every board peripheral in dependency order.
///
/// Called by [`crate::pac::init`] after clocks and IO MUX are configured.
pub fn init() {
    
    init_uart0();
    
    init_usb_sj();
    
}





/// Bring up UART0 as the console at 115200 baud, 8N1.
///
/// Clock divider is computed from `APB_HZ` (80000000 Hz) and
/// the console baud rate (115200 baud).
pub fn init_uart0() {
    let p = unsafe { pac::Peripherals::steal() };
    const BAUD: u32 = 115200;
    // ESP32-C3 UART clkdiv is in Q20.4 fixed point: (APB << 4) / BAUD.
    let clkdiv: u32 = (APB_HZ << 4) / BAUD;
    p.uart0.clkdiv().write(|w| unsafe { w.clkdiv().bits(clkdiv >> 4).frag().bits((clkdiv & 0xF) as u8) });
    // 8 data bits, no parity, 1 stop bit.
    p.uart0.conf0().modify(|_, w| unsafe {
        w.bit_num().bits(0b11) // 8 data bits
         .parity_en().clear_bit()
         .stop_bit_num().bits(0b01) // 1 stop bit
         .tick_ref_always_on().set_bit()
    });
    // Reset FIFOs and wait for TX idle.
    p.uart0.conf0().modify(|_, w| w.rxfifo_rst().set_bit().txfifo_rst().set_bit());
    p.uart0.conf0().modify(|_, w| w.rxfifo_rst().clear_bit().txfifo_rst().clear_bit());
    while p.uart0.status().read().st_utx_out().bits() != 0 {}
}







