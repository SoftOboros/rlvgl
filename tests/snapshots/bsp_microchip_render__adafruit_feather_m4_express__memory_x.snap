 * for application code that wants them.
 */

MEMORY
{
  FLASH : ORIGIN = 0x00000000, LENGTH = 0x00080000    /* rx */
  RAM : ORIGIN = 0x20000000, LENGTH = 0x00030000    /* rwx */
