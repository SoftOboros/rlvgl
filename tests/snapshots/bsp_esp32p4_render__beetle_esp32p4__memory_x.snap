  PSRAM_CACHE : ORIGIN = 0x48000000, LENGTH = 0x04000000    /* rwx */
}

/* Aliases consumed by riscv-rt's link.x. */
REGION_ALIAS("REGION_TEXT",   FLASH_CACHE);
REGION_ALIAS("REGION_RODATA", FLASH_CACHE);
REGION_ALIAS("REGION_DATA",   HP_L2MEM);
