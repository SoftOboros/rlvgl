pub const U0_RTS_PORT: u8 = 0;
pub const U0_RTS_PIN: u8 = 5;
pub const U0_RTS_PSEL: u32 = 5;



/// Pin P0.7 — UARTE0_CTS.
pub const U0_CTS_PORT: u8 = 0;
pub const U0_CTS_PIN: u8 = 7;
pub const U0_CTS_PSEL: u32 = 7;



