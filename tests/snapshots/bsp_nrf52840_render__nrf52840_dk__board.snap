//! Board constants for nRF52840-DK.
//!
//! Pin definitions, clock frequencies, and feature flags extracted from
//! the board YAML spec.

/// Board name.
pub const BOARD_NAME: &str = "nRF52840-DK";

/// Chip name.
pub const CHIP_NAME: &str = "nRF52840";

/// HFCLK frequency in Hz.
pub const HFCLK_HZ: u32 = 64000000;

/// LFCLK frequency in Hz.
pub const LFCLK_HZ: u32 = 32768;



/// Pin P0.6 — UARTE0_TXD.
pub const U0_TX_PORT: u8 = 0;
pub const U0_TX_PIN: u8 = 6;
pub const U0_TX_PSEL: u32 = 6;



/// Pin P0.8 — UARTE0_RXD.
pub const U0_RX_PORT: u8 = 0;
pub const U0_RX_PIN: u8 = 8;
pub const U0_RX_PSEL: u32 = 8;



