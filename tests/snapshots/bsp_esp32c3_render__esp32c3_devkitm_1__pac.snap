//! Top-level PAC-style bring-up entry for ESP32-C3-DevKitM-1.
//!
//! Call [`init`] once from your application reset handler before touching
//! any peripheral. It performs the following in order:
//!
//! 1. [`crate::clocks::init`] — ungate `SYSTEM` clocks for used peripherals
//!    and release them from reset.
//! 2. [`crate::io_mux::init`] — route each board pin via IO MUX or the GPIO
//!    matrix per the `db/boards/esp32_c3_dev_kit_m_1.yaml` pin table.
//! 3. [`crate::peripherals::init`] — per-peripheral init (UART0 real when
//!    it is the console, others stubbed).
//!
//! The generated code uses the `esp32c3` PAC crate for all
//! register access; add it as a dependency of the consuming crate.

pub use esp32c3 as pac;

/// Bring up the board.
///
/// Safety: must be called exactly once from a single-threaded reset handler
/// before any other code touches `esp32c3::Peripherals`.
pub fn init() {
    crate::clocks::init();
    crate::io_mux::init();
    crate::peripherals::init();
}
