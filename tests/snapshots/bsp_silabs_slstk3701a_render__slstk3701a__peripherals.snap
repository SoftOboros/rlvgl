/// Integrated Circuit Interface" §28.5 for the CTRL / CLKDIV /
/// SADDR / SADDRMASK / EN register layout. CLKDIV derives from HFCLK
/// (50000000 Hz) and the target SCL frequency
/// (400000 Hz).
pub fn init_i2c2() {
    let _p = unsafe { pac::Peripherals::steal() };
