//! Board-level constants for MIMXRT1060-EVKB.
//!
//! Chip: MIMXRT1062 (cortex-m7, BGA196)
//! PAC crate: imxrt_ral

/// Board name.
pub const BOARD_NAME: &str = "MIMXRT1060-EVKB";

/// Chip identifier.
pub const CHIP: &str = "MIMXRT1062";

/// Target architecture.
pub const ARCH: &str = "cortex-m7";

/// PAC crate name.
pub const PAC_CRATE: &str = "imxrt_ral";

/// CPU clock in Hz.
pub const CPU_HZ: u32 = 600000000;

/// AHB bus clock in Hz.
pub const AHB_HZ: u32 = 600000000;

/// IPG bus clock in Hz.
pub const IPG_HZ: u32 = 150000000;

/// Crystal oscillator frequency in Hz.
pub const XTAL_HZ: u32 = 24000000;


/// On-board flash size in MB.
pub const FLASH_MB: u32 = 8;



/// On-board SDRAM size in MB.
pub const SDRAM_MB: u32 = 32;


