/// Initialize every board peripheral in dependency order.
///
/// Called by [`crate::pac::init`] after clocks and PORT PMUX are
/// configured.
pub fn init() {
    {% for name in peripherals_used %}
    init_{{ name }}();
    {% endfor %}
}

