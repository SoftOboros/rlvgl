<?xml version="1.0" encoding="UTF-8"?>
<!--
  media_player_normalized.scxml
  Normalized media-player state machine for SCTD-01.

  Provenance:
    Derived from: vendor/scjson/tutorial/Examples/Qt/SkodaBoleroInfotainment/Model/bolero.scxml
    Normalization reason: bolero.scxml uses the SCXML In() predicate for cross-orthogonal-region
    guards (mute state, repeat mode, source availability). In() is not admitted by the D-M1P6-2
    constrained ECMAScript subset because it crosses the expression-evaluator boundary into the
    SCXML runtime. This normalized form replaces In() checks with explicit datamodel variables
    (s_mute, s_repeat, s_source) that mirror the relevant orthogonal state, preserving the
    behavioral intent of the Bolero mediaPlayer subtree without requiring In().

    Conformant with: SCTD-00 section 5.3 (normalized forms with provenance);
                     D-M1P6-7 (faithful-vs-blocked contract).
    States preserved: mediaPlayer -> mediaPlayerIdle -> mediaPlayerRun ->
                      mediaStopped -> mediaPlaying -> mediaPaused hierarchy.
    Orthogonal regions removed: muteType, displaySoundHandler, bandType.
    These are replaced by s_mute and s_source datamodel variables.

  Events (inputs):
    Inp.Media.Ready         -- media input is connected and ready
    Inp.Media.ValidSource   -- valid playback source selected
    Inp.Media.Play          -- user pressed play
    Inp.Media.Pause         -- user pressed pause
    Inp.Media.PlayPause     -- single toggle (QT-05g): machine owns play/pause decision
    Inp.Media.Stop          -- track ended or user stopped
    Inp.Media.Next          -- forward / next track
    Inp.Media.Prev          -- reverse / prev track
    Inp.Media.Source.USB    -- select USB source
    Inp.Media.Source.SD     -- select SD source
    Inp.Media.Source.AUX    -- select AUX source
    Inp.Media.Mute          -- toggle mute
    Inp.Media.Repeat        -- cycle repeat mode (none / track / folder)
    Inp.Media.Error         -- error from host media layer

  Events (outputs/sends):
    Out.Media.Play          -- command host to start playback
    Out.Media.Pause         -- command host to pause
    Out.Media.Stop          -- command host to stop
    Out.Media.Track.Next    -- advance track
    Out.Media.Track.Prev    -- reverse track
    Out.Media.Source.New    -- new source selected; host should load
-->
<scxml datamodel="ecmascript" initial="mediaPlayerIdle"
       name="MediaPlayerNorm" version="1.0"
       xmlns="http://www.w3.org/2005/07/scxml">

  <datamodel>
    <!-- Current audio source: 'USB' | 'SD' | 'AUX' -->
    <data id="s_source" expr="&quot;USB&quot;"/>
    <!-- Mute flag: true when muted -->
    <data id="s_mute" expr="false"/>
    <!-- Repeat mode: 'none' | 'track' | 'folder' -->
    <data id="s_repeat" expr="&quot;none&quot;"/>
    <!-- Last player state: 0=stopped, 1=playing, 2=paused -->
    <data id="i_player_state" expr="0"/>
  </datamodel>

  <!-- ================================================================
       Idle: waiting for media input to become ready
       ================================================================ -->
  <state id="mediaPlayerIdle">
    <transition event="Inp.Media.Ready" target="mediaPlayerRun"/>
  </state>

  <!-- ================================================================
       Running: source selection and transport sub-states
       ================================================================ -->
  <state id="mediaPlayerRun" initial="mediaPlayerSourceSelect">
    <onexit>
      <send event="Out.Media.Pause"/>
    </onexit>

    <!-- ---- Source selection ---- -->
    <state id="mediaPlayerSourceSelect">
      <onentry>
        <send event="Out.Media.Source.New"/>
      </onentry>
      <transition event="Inp.Media.Source.USB">
        <assign location="s_source" expr="&quot;USB&quot;"/>
        <send event="Out.Media.Source.New"/>
      </transition>
      <transition event="Inp.Media.Source.SD">
        <assign location="s_source" expr="&quot;SD&quot;"/>
        <send event="Out.Media.Source.New"/>
      </transition>
      <transition event="Inp.Media.Source.AUX">
        <assign location="s_source" expr="&quot;AUX&quot;"/>
        <send event="Out.Media.Source.New"/>
      </transition>
      <transition event="Inp.Media.ValidSource" target="mediaPlayerTransport"/>
    </state>

    <!-- ================================================================
         Transport: stopped / playing / paused
         ================================================================ -->
    <state id="mediaPlayerTransport" initial="mediaStopped">
      <transition event="Inp.Media.Error" target="mediaPlayerError"/>

      <!-- Source change while playing: update and reload -->
      <transition event="Inp.Media.Source.USB">
        <assign location="s_source" expr="&quot;USB&quot;"/>
        <send event="Out.Media.Source.New"/>
      </transition>
      <transition event="Inp.Media.Source.SD">
        <assign location="s_source" expr="&quot;SD&quot;"/>
        <send event="Out.Media.Source.New"/>
      </transition>
      <transition event="Inp.Media.Source.AUX">
        <assign location="s_source" expr="&quot;AUX&quot;"/>
        <send event="Out.Media.Source.New"/>
      </transition>

      <!-- Mute toggle -->
      <transition event="Inp.Media.Mute">
        <assign location="s_mute" expr="!s_mute"/>
      </transition>

      <!-- Repeat mode cycle: none -> track -> folder -> none -->
      <transition event="Inp.Media.Repeat">
        <if cond="s_repeat === &quot;none&quot;">
          <assign location="s_repeat" expr="&quot;track&quot;"/>
          <elseif cond="s_repeat === &quot;track&quot;"/>
          <assign location="s_repeat" expr="&quot;folder&quot;"/>
          <else/>
          <assign location="s_repeat" expr="&quot;none&quot;"/>
        </if>
      </transition>

      <!-- Next / Previous track -->
      <transition event="Inp.Media.Next">
        <send event="Out.Media.Track.Next"/>
      </transition>
      <transition event="Inp.Media.Prev">
        <send event="Out.Media.Track.Prev"/>
      </transition>

      <!-- ---- Stopped ---- -->
      <state id="mediaStopped">
        <onentry>
          <assign location="i_player_state" expr="0"/>
          <!-- Normalized: explicit s_repeat check replaces In("mediaRepeatTrack") -->
          <if cond="s_repeat === &quot;track&quot;">
            <send event="Out.Media.Play"/>
            <else/>
            <send event="Out.Media.Track.Next"/>
          </if>
        </onentry>
        <transition event="Inp.Media.Play" cond="!s_mute" target="mediaPlaying">
          <send event="Out.Media.Play"/>
        </transition>
        <transition event="Inp.Media.Play" cond="s_mute" target="mediaPaused"/>
        <!-- QT-05g: single toggle event so the UI Play button maps 1:1; the
             machine owns the play/pause decision (not glue). From stopped a
             toggle starts playback. -->
        <transition event="Inp.Media.PlayPause" target="mediaPlaying">
          <send event="Out.Media.Play"/>
        </transition>
      </state>

      <!-- ---- Playing ---- -->
      <state id="mediaPlaying">
        <onentry>
          <assign location="i_player_state" expr="1"/>
        </onentry>
        <transition event="Inp.Media.Pause" target="mediaPaused">
          <send event="Out.Media.Pause"/>
        </transition>
        <!-- QT-05g: toggle while playing → pause. -->
        <transition event="Inp.Media.PlayPause" target="mediaPaused">
          <send event="Out.Media.Pause"/>
        </transition>
        <transition event="Inp.Media.Stop" target="mediaStopped">
          <send event="Out.Media.Stop"/>
        </transition>
      </state>

      <!-- ---- Paused ---- -->
      <state id="mediaPaused">
        <onentry>
          <assign location="i_player_state" expr="2"/>
        </onentry>
        <transition event="Inp.Media.Play" cond="!s_mute" target="mediaPlaying">
          <send event="Out.Media.Play"/>
        </transition>
        <!-- QT-05g: toggle while paused → resume playback. -->
        <transition event="Inp.Media.PlayPause" target="mediaPlaying">
          <send event="Out.Media.Play"/>
        </transition>
        <transition event="Inp.Media.Stop" target="mediaStopped">
          <send event="Out.Media.Stop"/>
        </transition>
      </state>
    </state>

    <!-- Error recovery -->
    <state id="mediaPlayerError">
      <transition event="Inp.Media.Ready" target="mediaPlayerSourceSelect"/>
    </state>
  </state>

</scxml>
