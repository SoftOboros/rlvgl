# pins.local.tcl.template - board-specific Quartus pin assignments.
#
# Copy this file to pins.local.tcl, replace every PIN_* placeholder, and keep
# pins.local.tcl uncommitted if it is specific to one bench board.

# Clock, reset, and button input.
set_location_assignment PIN_CLK_12MHZ -to clk_12mhz
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_12mhz

set_location_assignment PIN_RESET -to rst
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst

set_location_assignment PIN_BUTTON -to button_raw
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to button_raw

# Philosopher 1 RGB.
set_location_assignment PIN_P1_R -to p1_r
set_location_assignment PIN_P1_G -to p1_g
set_location_assignment PIN_P1_B -to p1_b
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to p1_r
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to p1_g
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to p1_b

