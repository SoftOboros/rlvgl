+const RLE_ROW_PIXELS: usize = 800;
+
+/// No-heap RLE image widget for embedded targets.
+///
+/// The first port of the generated media player expanded each RLE asset into a
+/// leaked `Vec<Color>`. That is fine on the simulator and ESP32-P4, but the
+/// STM32H747I-DISCO firmware has a 64 KiB Rust heap; the Bolero background
+/// alone expands to more than 800 KiB. This widget keeps the generated shape
+/// intact while streaming one decoded row at a time through the renderer.
+pub struct RleImage {
+    bounds: Rect,
+    art: ImageArt,
+    hidden: bool,
+}
+
+impl RleImage {
+    fn new(bounds: Rect, art: ImageArt) -> Self {
+        Self {
+            bounds,
+            art,
+            hidden: false,
+        }
+    }
+
+    fn set_art(&mut self, art: ImageArt) {
+        self.art = art;
+    }
+
+    fn set_hidden(&mut self, hidden: bool) {
+        self.hidden = hidden;
+    }
+}
+
+impl Widget for RleImage {
+    fn bounds(&self) -> Rect {
+        self.bounds
+    }
+
+    fn draw(&self, renderer: &mut dyn rlvgl_core::renderer::Renderer) {
+        if self.hidden || self.bounds.width <= 0 || self.bounds.height <= 0 {
+            return;
+        }
+        let Ok((w, h, palette_bytes, stream)) = rlvgl_decomp::parse_rle_blob(self.art.rle) else {
+            return;
+        };
+        let src_w = w as usize;
+        let src_h = h as usize;
+        if src_w == 0 || src_h == 0 || src_w > RLE_ROW_PIXELS {
+            return;
+        }
+        let dest_w = self.bounds.width as usize;
+        if dest_w == 0 || dest_w > RLE_ROW_PIXELS {
+            return;
+        }
+        let palette_len = palette_bytes.len() / 2;
+        if palette_len > rlvgl_decomp::consts::MAX_PALETTE {
+            return;
+        }
+        let mut palette = [0u16; rlvgl_decomp::consts::MAX_PALETTE];
+        for i in 0..palette_len {
+            palette[i] = u16::from_le_bytes([palette_bytes[i * 2], palette_bytes[i * 2 + 1]]);
+        }
+
+        let mut row = [Color(0, 0, 0, 0); RLE_ROW_PIXELS];
+        let mut stream_i = 0usize;
+        let mut src_x = 0usize;
+        let mut src_y = 0usize;
+        let mut recent_idx = 0usize;
+
+        while stream_i < stream.len() && src_y < src_h {
+            let b = stream[stream_i];
+            stream_i += 1;
+            match b {
+                rlvgl_decomp::consts::ENCODE_KEY_SINGLE_INLINE_PIXEL => {
+                    if stream_i + 1 >= stream.len() {
+                        return;
+                    }
+                    let c = ((stream[stream_i] as u16) << 8) | stream[stream_i + 1] as u16;
+                    stream_i += 2;
+                    emit_rle_pixel(
+                        rgb565_color(c),
+                        renderer,
+                        self.bounds,
+                        src_w,
+                        src_h,
+                        &mut row,
+                        &mut src_x,
+                        &mut src_y,
+                    );
+                }
+                rlvgl_decomp::consts::ENCODE_KEY_DOUBLE_INLINE_PIXEL => {
+                    if stream_i + 1 >= stream.len() {
+                        return;
+                    }
+                    let c = ((stream[stream_i] as u16) << 8) | stream[stream_i + 1] as u16;
+                    stream_i += 2;
+                    emit_rle_run(
+                        rgb565_color(c),
+                        2,
+                        renderer,
+                        self.bounds,
+                        src_w,
+                        src_h,
+                        &mut row,
+                        &mut src_x,
+                        &mut src_y,
+                    );
+                }
+                rlvgl_decomp::consts::ENCODE_KEY_LONG_REPEAT => {
+                    if stream_i >= stream.len() || recent_idx >= palette_len {
+                        return;
+                    }
+                    let count = rlvgl_decomp::consts::SHORT_REPEAT_MAX as usize
+                        + 1
+                        + stream[stream_i] as usize;
+                    stream_i += 1;
+                    emit_rle_run(
+                        rgb565_color(palette[recent_idx]),
+                        count,
+                        renderer,
+                        self.bounds,
+                        src_w,
+                        src_h,
+                        &mut row,
+                        &mut src_x,
+                        &mut src_y,
+                    );
+                }
+                data => {
+                    let data = data as usize;
+                    if data < palette_len {
+                        recent_idx = data;
+                        emit_rle_pixel(
+                            rgb565_color(palette[data]),
+                            renderer,
+                            self.bounds,
+                            src_w,
+                            src_h,
+                            &mut row,
+                            &mut src_x,
+                            &mut src_y,
+                        );
+                    } else {
+                        if recent_idx >= palette_len {
+                            return;
+                        }
+                        let count = data.saturating_sub(palette_len).saturating_add(1);
+                        emit_rle_run(
+                            rgb565_color(palette[recent_idx]),
+                            count,
+                            renderer,
+                            self.bounds,
+                            src_w,
+                            src_h,
+                            &mut row,
+                            &mut src_x,
+                            &mut src_y,
+                        );
+                    }
+                }
+            }
+        }
+    }
+
+    fn handle_event(&mut self, _event: &rlvgl_core::event::Event) -> bool {
+        false
+    }
+}
+
+fn rgb565_color(c: u16) -> Color {
+    let r5 = ((c >> 11) & 0x1F) as u8;
+    let g6 = ((c >> 5) & 0x3F) as u8;
+    let b5 = (c & 0x1F) as u8;
+    let r = (r5 << 3) | (r5 >> 2);
+    let g = (g6 << 2) | (g6 >> 4);
+    let b = (b5 << 3) | (b5 >> 2);
+    if r == 0xFF && g == 0x00 && b == 0xFF {
+        Color(0x00, 0x00, 0x00, 0x00)
+    } else {
+        Color(r, g, b, 0xFF)
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn emit_rle_run(
+    color: Color,
+    count: usize,
+    renderer: &mut dyn rlvgl_core::renderer::Renderer,
+    bounds: Rect,
+    src_w: usize,
+    src_h: usize,
+    row: &mut [Color; RLE_ROW_PIXELS],
+    src_x: &mut usize,
+    src_y: &mut usize,
+) {
+    for _ in 0..count {
+        emit_rle_pixel(color, renderer, bounds, src_w, src_h, row, src_x, src_y);
+        if *src_y >= src_h {
+            return;
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn emit_rle_pixel(
+    color: Color,
+    renderer: &mut dyn rlvgl_core::renderer::Renderer,
+    bounds: Rect,
+    src_w: usize,
+    src_h: usize,
+    row: &mut [Color; RLE_ROW_PIXELS],
+    src_x: &mut usize,
+    src_y: &mut usize,
+) {
+    if *src_y >= src_h || *src_x >= src_w {
+        return;
+    }
+    row[*src_x] = color;
+    *src_x += 1;
+    if *src_x == src_w {
+        draw_scaled_rle_row(renderer, bounds, src_w, src_h, *src_y, row);
+        *src_y += 1;
+        *src_x = 0;
+    }
+}
+
+fn draw_scaled_rle_row(
+    renderer: &mut dyn rlvgl_core::renderer::Renderer,
+    bounds: Rect,
+    src_w: usize,
+    src_h: usize,
+    src_y: usize,
+    row: &mut [Color; RLE_ROW_PIXELS],
+) {
+    let dest_w = bounds.width as usize;
+    let dest_h = bounds.height as usize;
+    if dest_w == 0 || dest_h == 0 {
+        return;
+    }
+    for dx in (0..dest_w).rev() {
+        let sx = dx * src_w / dest_w;
+        row[dx] = row[sx];
+    }
+    let y0 = (src_y * dest_h).div_ceil(src_h);
+    let y1 = ((src_y + 1) * dest_h).div_ceil(src_h);
+    for dy in y0..y1 {
+        renderer.draw_pixels(
+            (bounds.x, bounds.y + dy as i32),
+            &row[..dest_w],
+            dest_w as u32,
+            1,
+        );
+    }
+}
