{
  // VS Code tasks for rlvgl STM32H747I-DISCO builds
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-disco (cm7)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--target", "thumbv7em-none-eabihf",
        "--bin", "rlvgl-stm32h747i-disco",
        "--features", "stm32h747i_disco_cm7,dma2d,backlight_pwm,pac_sdram_init,sdram_ramtest"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build-disco (cm7, release)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "--target", "thumbv7em-none-eabihf",
        "--bin", "rlvgl-stm32h747i-disco",
        "--features", "stm32h747i_disco_cm7,dma2d,backlight_pwm,pac_sdram_init,sdram_ramtest"
      ],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build-disco (cm7 + sdram)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--target", "thumbv7em-none-eabihf",
        "--bin", "rlvgl-stm32h747i-disco",
        "--features", "stm32h747i_disco_cm7,dma2d,backlight_pwm,pac_sdram_init,sdram_ramtest"
      ],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build-disco (cm4)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--target", "thumbv7em-none-eabihf",
        "--bin", "rlvgl-stm32h747i-disco-cm4",
        "--features", "stm32h747i_disco_cm4"
      ],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build-sim",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--bin", "rlvgl-sim",
        "--features", "simulator,qrcode,png,jpeg,gif,fontdue"
      ],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build-creator",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--bin", "rlvgl-creator",
        "--features", "creator"
      ],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "probe-rs download (cm7)",
      "type": "shell",
      "dependsOn": "build-disco (cm7)",
      "dependsOrder": "sequence",
      "command": "probe-rs",
      "args": [
        "download",
        "--chip",
        "STM32H747XIHx",
        "--protocol",
        "swd",
        "--speed",
        "1000",
        "--non-interactive",
        "--connect-under-reset",
        "--probe",
        "0483:374e:004F00273133510837363734",
        "${workspaceFolder}/target/thumbv7em-none-eabihf/debug/rlvgl-stm32h747i-disco"
      ],
      "problemMatcher": {
        "owner": "probe-rs",
        "pattern": [
          {
            "regexp": "^((?:.:)?[^:]+):(\\d+):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        ]
      }
    },
    {
      "label": "probe-rs gdb (cm7)",
      "type": "shell",
      "isBackground": true,
      "dependsOn": [
        "probe-rs download (cm7)"
      ],
      "dependsOrder": "sequence",
      "command": "probe-rs",
      "args": [
        "gdb",
        "--chip",
        "STM32H747XIHx",
        "--protocol",
        "swd",
        "--speed",
        "50",
        "--non-interactive",
        "--connect-under-reset",
        "--probe",
        "0483:374e:004F00273133510837363734",
        "--reset-halt"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": {
        "owner": "probe-rs",
        "pattern": [
          {
            "regexp": "^((?:.:)?[^:]+):(\\d+):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting GDB server.*",
          "endsPattern": ".*(Waiting|Listening|Shutting down) for (a )?GDB connection.*"
        }
      }
    }
  ]
}
