{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-disco (cm7)",
      "type": "shell",
      "command": "make",
      "args": ["build-disco"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build-disco (cm7, release)",
      "type": "shell",
      "command": "make",
      "args": ["build-disco-release"],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build-disco (cm4)",
      "type": "shell",
      "command": "make",
      "args": ["build-disco-cm4"],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "flash-disco (cm7)",
      "type": "shell",
      "command": "make",
      "args": ["flash-disco"],
      "dependsOn": "build-disco (cm7)",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "build-sim",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "-p", "rlvgl-example-sim",
        "--bin", "rlvgl-sim"
      ],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build-creator",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--bin", "rlvgl-creator",
        "--features", "creator"
      ],
      "group": "build",
      "problemMatcher": ["$rustc"]
    }
  ]
}
