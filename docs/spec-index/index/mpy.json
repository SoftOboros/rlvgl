      "family": "mpy",
      "kind": "term",
      "line": 108,
      "obj_id": "mpy:term:introspection parity",
      "text": "Named coverage of the pinned LVGL class, tree, creation, property, event, layout/style/state, and diagnostic surfaces using stable rlvgl semantics rather than raw LVGL pointers."
    },
