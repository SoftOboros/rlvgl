  "objects": [
    {
      "attrs": {
        "relationship": "Owned by MPY; implemented over LPAR object/runtime semantics. Does not exist as a single repository type yet.",
        "term": "Stage"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 91,
      "obj_id": "mpy:term:stage",
      "text": "A runtime-owned UI session containing one or more roots, their object trees, ordering, requested layout/style/state, focus routing, subscriptions, and pending directions. It is broader than a display screen."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-06; does not exist in the repository yet.",
        "term": "Director"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 92,
      "obj_id": "mpy:term:director",
      "text": "The MicroPython application that owns high-level application state and decides which actors exist, how they are configured, and how cues affect later stage directions."
    },
    {
      "attrs": {
        "relationship": "Owned jointly by MPY runtime identity and the applicable rlvgl widget implementation.",
        "term": "Actor"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 93,
      "obj_id": "mpy:term:actor",
      "text": "A live, runtime-owned object instantiated from a registered native actor type. It measures, participates in layout, handles native input semantics, animates, and draws through rlvgl."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-05 and MPY-06; adapted from `core::object::ObjectEvent`.",
        "term": "Cue"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 94,
      "obj_id": "mpy:term:cue",
      "text": "A typed notification emitted by rlvgl for a subscribed actor and delivered to a director callback at a VM-safe point. A cue reports completed or observed runtime activity; it is not a synchronous call into Python."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-02 through MPY-05; does not exist as a complete command enum yet.",
        "term": "Stage Direction"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 95,
      "obj_id": "mpy:term:stage direction",
      "text": "A typed command that requests object creation, deletion, tree mutation, property/state/style mutation, layout intent, subscription changes, or a commit boundary."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-05; does not exist as a named repository primitive yet.",
        "term": "Performance Turn"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 96,
      "obj_id": "mpy:term:performance turn",
      "text": "One safe runtime turn in which a committed command batch is applied, native runtime work proceeds, and resulting cues become available in deterministic order."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-02; does not exist in the repository yet.",
        "term": "Object ID"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 97,
      "obj_id": "mpy:term:object id",
      "text": "An opaque, generation-checked handle that identifies one live actor without exposing a Rust or C pointer."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-05/06; does not exist in the repository yet.",
        "term": "Callback ID"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 98,
      "obj_id": "mpy:term:callback id",
      "text": "An opaque token associating an rlvgl subscription with a callable retained by the MicroPython adapter."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-02; does not exist in the repository yet.",
        "term": "Request ID"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 99,
      "obj_id": "mpy:term:request id",
      "text": "A correlation token connecting a command or committed batch to exactly one structured success or failure result, independently of asynchronous cues."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-03; does not exist in the repository yet.",
        "term": "Type Descriptor"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 100,
      "obj_id": "mpy:term:type descriptor",
      "text": "Discoverable schema for an actor type: stable identifier and name, ancestry or capabilities, constructor requirements, properties, actions, events, child policy, and target availability."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-03/04; extends but does not replace `core::property::Queryable`.",
        "term": "Property Descriptor"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 101,
      "obj_id": "mpy:term:property descriptor",
      "text": "Schema for one named property, including value type, access mode, default or absence, constraints, invalidation effects, and applicable actor types."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-03/04; does not exist in the repository yet.",
        "term": "Action Descriptor"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 102,
      "obj_id": "mpy:term:action descriptor",
      "text": "Schema for a typed actor operation that is not adequately represented as durable state, such as focus, scroll-to, start, stop, or collection mutation."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-05; adapted from LPAR-04 event semantics.",
        "term": "Event Descriptor"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 103,
      "obj_id": "mpy:term:event descriptor",
      "text": "Schema for one event or cue, including payload fields, delivery policy, coalescing policy, and applicable actor types."
    },
    {
      "attrs": {
        "relationship": "Semantics owned by LPAR-10; scripting exposure owned by MPY-04.",
        "term": "Requested Layout"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 104,
      "obj_id": "mpy:term:requested layout",
      "text": "Director-authored layout intent such as flex/grid configuration, dimensions, constraints, placement, alignment, growth, or span."
    },
    {
      "attrs": {
        "relationship": "Semantics owned by LPAR-10; introspection exposure owned by MPY-04.",
        "term": "Computed Geometry"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 105,
      "obj_id": "mpy:term:computed geometry",
      "text": "Runtime-produced effective bounds and related layout results after actors measure and rlvgl performs layout. It is observable but not director-writable."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-04/07; does not exist in the repository yet.",
        "term": "Runtime Snapshot"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 106,
      "obj_id": "mpy:term:runtime snapshot",
      "text": "A deterministic, read-only projection of stage roots, actor identity/type, hierarchy, requested state, computed state, and active subscriptions."
    },
    {
      "attrs": {
        "relationship": "Owned by MPY-02/07/08.",
        "term": "Transport Profile"
      },
      "doc": "docs/concepts/MPY-00-CONCEPTS.md",
      "family": "mpy",
      "kind": "term",
      "line": 107,
      "obj_id": "mpy:term:transport profile",
      "text": "The carrier used for the same command/event protocol, initially in-process and later bounded CM7/CM4 queues."
    },
    {
      "attrs": {
        "relationship": "Baseline owned by LPAR-01; scripting coverage owned by MPY-01 and closed incrementally by later phases.",
        "term": "Introspection Parity"
      },
