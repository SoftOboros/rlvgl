        "term": "Software-reference oracle"
      },
      "doc": "docs/concepts/FONT-00-CONCEPTS.md",
      "family": "font",
      "kind": "term",
      "line": 129,
      "obj_id": "font:term:software-reference oracle",
      "text": "The deterministic `core` coverage path (`draw_glyph_coverage` → default `blend_row`). The canonical pixels a hardware path must match within §5.H."
    },
