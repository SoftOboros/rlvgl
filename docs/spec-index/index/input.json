      "obj_id": "input:term:dragrecognizer",
      "text": "The middleware (`platform/src/gesture.rs`) folding raw pointer events into `DragStart`/`DragMove`/`DragEnd` once movement crosses the start threshold."
    },
    {
      "attrs": {
