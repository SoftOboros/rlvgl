      "family": "input",
      "kind": "term",
      "line": 51,
      "obj_id": "input:term:start threshold",
      "text": "Minimum pointer displacement from the press origin before a drag begins. Default [`DRAG_START_THRESHOLD_PX`] = 10. Metric: **Euclidean, compared squared** (§5.1)."
    },
    {
      "attrs": {
        "relationship": "INPUT",
