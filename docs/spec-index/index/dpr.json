    {
      "attrs": {
        "relationship": "DPR.",
        "term": "Disco Platform Runtime"
      },
      "doc": "docs/concepts/DPR-00-CONCEPTS.md",
      "family": "dpr",
      "kind": "term",
      "line": 79,
      "obj_id": "dpr:term:disco platform runtime",
      "text": "The reusable RLVGL-owned runtime surface for STM32H747I-DISCO board bring-up, display scheduling, warm-reset cleanup, IRQ ownership, and board telemetry."
    },
    {
      "attrs": {
        "relationship": "DPR.",
        "term": "First App"
      },
      "doc": "docs/concepts/DPR-00-CONCEPTS.md",
      "family": "dpr",
      "kind": "term",
      "line": 80,
      "obj_id": "dpr:term:first app",
      "text": "The existing RLVGL STM32H747I-DISCO demo. It remains the first hardware validation target for every DPR phase."
    },
    {
      "attrs": {
        "relationship": "DPR.",
        "term": "Second App"
      },
      "doc": "docs/concepts/DPR-00-CONCEPTS.md",
      "family": "dpr",
      "kind": "term",
      "line": 81,
      "obj_id": "dpr:term:second app",
      "text": "The disco analyzer. It proves the runtime surface can serve a non-demo application with audio/DSP constraints and different frame pacing needs."
    },
    {
      "attrs": {
        "relationship": "DPR.",
        "term": "Board Runtime"
      },
      "doc": "docs/concepts/DPR-00-CONCEPTS.md",
      "family": "dpr",
      "kind": "term",
      "line": 82,
      "obj_id": "dpr:term:board runtime",
      "text": "The initialized collection of board services returned by a platform entry point: display, frame scheduler, optional audio/codec services, input handles, telemetry, and any ownership tokens needed to install ISRs safely."
    },
    {
      "attrs": {
        "relationship": "DPR.",
        "term": "Runtime Profile"
      },
      "doc": "docs/concepts/DPR-00-CONCEPTS.md",
      "family": "dpr",
      "kind": "term",
      "line": 83,
      "obj_id": "dpr:term:runtime profile",
      "text": "A named configuration for Board Runtime construction. Profiles choose policy, not hardware facts: e.g. demo vs analyzer display mode, audio ownership, render pacing, and telemetry slots."
    },
    {
      "attrs": {
        "relationship": "DPR.",
        "term": "Warm-Reset Safe Stop"
      },
      "doc": "docs/concepts/DPR-00-CONCEPTS.md",
      "family": "dpr",
      "kind": "term",
      "line": 84,
      "obj_id": "dpr:term:warm-reset safe stop",
      "text": "A bounded sequence that stops autonomous peripherals left running across CPU reset, clears pending IRQs, and records telemetry before normal init programs those peripherals."
    },
    {
      "attrs": {
        "relationship": "DPR.",
        "term": "Frame Scheduler"
      },
      "doc": "docs/concepts/DPR-00-CONCEPTS.md",
      "family": "dpr",
      "kind": "term",
      "line": 85,
      "obj_id": "dpr:term:frame scheduler",
      "text": "The platform object that owns DSI ERIF handling, LTDC layer handoff, render-dirty gating, optional holdoff timing, and the single-writer rule for display MMIO."
    },
    {
      "attrs": {
        "relationship": "DPR.",
        "term": "Scan Mode"
      },
      "doc": "docs/concepts/DPR-00-CONCEPTS.md",
      "family": "dpr",
      "kind": "term",
      "line": 86,
      "obj_id": "dpr:term:scan mode",
      "text": "The DSI/LTDC scheduling strategy selected by a profile. Initial values are `AdaptedCommandHoldoff` and `VideoShadowReload`; see §5."
    },
    {
      "attrs": {
        "relationship": "DPR.",
        "term": "Display MMIO Owner"
      },
      "doc": "docs/concepts/DPR-00-CONCEPTS.md",
      "family": "dpr",
      "kind": "term",
      "line": 87,
      "obj_id": "dpr:term:display mmio owner",
      "text": "The sole code path allowed to write `DSI_WCR`, `DSI_WIER`, `LTDC_LxCFBAR`, and `LTDC_SRCR` after display init. In DPR, this is the Frame Scheduler."
    },
    {
      "attrs": {
        "relationship": "DPR.",
        "term": "Platform Telemetry"
      },
      "doc": "docs/concepts/DPR-00-CONCEPTS.md",
      "family": "dpr",
      "kind": "term",
      "line": 88,
      "obj_id": "dpr:term:platform telemetry",
      "text": "SRAM4 or serial breadcrumbs emitted by Board Runtime primitives for bench validation. Telemetry addresses are part of a profile contract and MUST avoid application-owned slots."
    },
