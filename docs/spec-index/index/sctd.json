      "doc": "docs/concepts/SCTD-02-FIREBEETLE-P4-INTERACTIVE.md",
      "family": "sctd",
      "kind": "term",
      "line": 104,
      "obj_id": "sctd:term:lifecycle event",
      "text": "A host-injected SCXML external event consumed by the Interactive DP machine: `PHILOSOPHER_ARRIVE`, `PHILOSOPHER_DEPART`, `DEADLOCK_BREAK`, `SIMULATION_RESET`."
    },
    {
      "attrs": {
        "relationship": "SCTD-02 (§5)",
        "term": "Pending depart"
